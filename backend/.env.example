# ARMSS-OTT Backend Configuration
PORT=8081
ENV=production

# ─── MySQL Database (MySQL with SQLite auto fallback) ─────────────────────────
MYSQL_USER=root
MYSQL_PASSWORD=Vetri@123
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DB=armss_ott
MYSQL_DSN=

# ─── Redis (Task Queue for Asynq) ─────────────────────────────────────────────
REDIS_ADDR=127.0.0.1:6379
REDIS_PASSWORD=

# ─── S3-Compatible Storage (MinIO in local dev, Cloudflare R2 in prod) ────────
S3_ENDPOINT=http://127.0.0.1:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_REGION=us-east-1
S3_USE_PATH_STYLE=true
S3_MASTERS_BUCKET=masters
S3_HLS_BUCKET=hls
S3_PUBLIC_BASE_URL=http://localhost:9000

# ─── Transcoder & Worker Settings ──────────────────────────────────────────────
ENABLE_WORKER=true
RUN_AS_WORKER_ONLY=false
TRANSCODE_CONCURRENCY=2
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe
ENABLE_HLS_ENCRYPTION=false

# ─── Security & Tokens ────────────────────────────────────────────────────────
JWT_SECRET=armss-ott-super-secret-jwt-key-change-in-production-2024

# ─── CORS Allowed Origins ─────────────────────────────────────────────────────
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8080

# ─── Uploads directory ────────────────────────────────────────────────────────
UPLOADS_DIR=./public/uploads

# ─── Email Service (Bird API or SMTP) ──────────────────────────────────────────
BIRD_API_KEY=
BIRD_API_URL=https://eu1.platform.bird.com/v1/email/messages
BIRD_FROM_EMAIL=noreply@yourdomain.com
BIRD_FROM_NAME=ARMSS OTT

SMTP_HOST=
SMTP_PORT=465
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_ADDRESS=
