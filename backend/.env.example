# ARMSS-OTT Backend Configuration
PORT=8081
ENV=production

# ─── MySQL Database (MySQL Only — No SQLite fallback) ─────────────────────────
# Option 1: Individual fields (recommended)
MYSQL_USER=root
MYSQL_PASSWORD=Vetri@123
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DB=armss_ott

# Option 2: Full DSN override (overrides individual fields above if set)
# Format: user:password@tcp(host:port)/dbname?parseTime=true&multiStatements=true
MYSQL_DSN=

# ─── Security & Tokens ────────────────────────────────────────────────────────
# Change this to a long random string in production (min 32 characters)
JWT_SECRET=armss-ott-super-secret-jwt-key-change-in-production-2024

# ─── CORS Allowed Origins ─────────────────────────────────────────────────────
# Comma-separated list of allowed origins. Use * only in production behind a proxy.
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8080

# ─── Uploads directory ────────────────────────────────────────────────────────
UPLOADS_DIR=./public/uploads

# ─── Email Service (Bird API or SMTP) ──────────────────────────────────────────
# Option A: Bird Email REST API
BIRD_API_KEY=
BIRD_API_URL=https://eu1.platform.bird.com/v1/email/messages
BIRD_FROM_EMAIL=noreply@yourdomain.com
BIRD_FROM_NAME=ARMSS OTT

# Option B: Standard SMTP Relay (Port 465 SSL/TLS or Port 587 STARTTLS)
SMTP_HOST=
SMTP_PORT=465
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_ADDRESS=
