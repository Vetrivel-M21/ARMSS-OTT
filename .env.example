# ----------------------------------------------------
# ARMSS-OTT Production Docker Environment Configuration
# ----------------------------------------------------

# Domain name used by the Windows redirect proxy (e.g., ott.yourdomain.com or localhost)
DOMAIN=aurapictures.online

# Gateway Port exposed on the Ubuntu server (Internal Nginx reverse proxy)
GATEWAY_PORT=8088

# Direct service ports (accessible directly on Ubuntu host if needed)
BACKEND_PORT=8090
FRONTEND_PORT=8091

# Client API URL (/api routes through the internal Nginx gateway)
VITE_API_BASE_URL=/api

# Internal SSR API URL (used by the Node.js SSR server inside Docker to reach the backend)
# Must point to the backend container name and port — NOT localhost
INTERNAL_API_URL=http://backend:8090/api

# MySQL Database Configuration
MYSQL_PASSWORD=SecurePassword@2026

# SeaweedFS Object Storage (S3 API) Configuration
S3_ACCESS_KEY=ottadmin
S3_SECRET_KEY=SuperSecretMinioPassword2026

# Video Streaming Public Base URL (/hls routes through the internal Nginx gateway)
S3_PUBLIC_BASE_URL=/hls

# Transcoder Concurrency (Recommended: 2 for 4-core VPS, 4 for 8-core VPS)
TRANSCODE_CONCURRENCY=2

# Security & Authentication
JWT_SECRET=replace-with-a-random-32-character-secret-string-2026

# CORS: Set to your public domain(s) or *
ALLOWED_ORIGINS=*

# Google OAuth (Optional)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Razorpay Payment Gateway (Optional)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
